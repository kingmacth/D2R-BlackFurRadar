{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "d2r-blackfur-radar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "RADAR", "class_name": "RadarState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RadarState"] }],
  "vars": {
    "WXPUSH_URL": "",
    "WXPUSH_USER_ID": "",
    "SITE_URL": "https://your-radar.example.com"
  },
  "observability": { "enabled": true }
}
